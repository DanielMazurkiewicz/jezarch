{
  "name": "jezarch-be",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3",
    "bun-plugin-tailwind": "^0.0.15",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "1.2.19",
    "@types/bcryptjs": "^3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "build": "bun -e \"await Bun.build({ entrypoints: ['index.ts'], outdir: 'dist', format: 'esm', target: 'bun', sourcemap: 'linked', naming: 'server.js' })\"",
    "test": "bun test ../backend-tests/**/*.test.ts",
    "test:file": "bun test",
    "seed": "bun run ../scripts/seed-data.ts",
    "seed:pl": "bun run ../scripts/seed-data-pl.ts",
    "seed:en": "bun run ../scripts/seed-data-en.ts",
    "dev": "bun run src/main.ts"
  }
}